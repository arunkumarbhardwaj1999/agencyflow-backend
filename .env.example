# Application
APP_NAME=AgencyFlow CRM
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agencyflow

# Legacy JWT fallback (optional)
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Supabase Auth (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Resend email (required for password reset)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=AgencyFlow <onboarding@resend.dev>

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT=100/minute
