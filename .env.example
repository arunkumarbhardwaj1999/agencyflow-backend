# Application
APP_NAME=AgencyFlow CRM
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agencyflow

# JWT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT=100/minute

# Frontend (used for payment redirect / mock pay links)
FRONTEND_URL=http://localhost:3000
CURRENCY=INR

# Payments — leave keys blank to run in mock mode (PAYMENTS_MOCK=true).
# In mock mode a local pay link is returned and /payments/invoices/{id}/simulate
# can mark an invoice paid without a real gateway.
PAYMENTS_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sign-In — OAuth 2.0 Web client ID (same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# File storage — Cloudflare R2 (S3-compatible). Leave blank to use local disk
# (./uploads) so uploads work in development without any cloud account.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
LOCAL_STORAGE_DIR=uploads
BACKEND_PUBLIC_URL=http://localhost:8000
MAX_UPLOAD_MB=10

# Email — Resend. Leave the API key blank to run in mock mode (emails are
# logged to the console instead of being sent).
RESEND_API_KEY=
EMAIL_FROM=noreply@agencyflow.in
EMAIL_FROM_NAME=AgencyFlow

# WhatsApp — Meta Cloud API. Leave blank for mock mode (logs to DB).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_AUTO_ON_PAYMENT=true
WHATSAPP_AUTO_ON_INVOICE_SEND=true
WHATSAPP_TEMPLATE_LANGUAGE=en

# AI — Anthropic Claude. Leave blank for mock mode (template drafts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_RATE_LIMIT=20/minute

# Background jobs — Redis + Celery for async WhatsApp queue
REDIS_URL=redis://localhost:6379/0
